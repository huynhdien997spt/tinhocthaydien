  {
    "requirementId": "G6-B-01",
    "topicId": "G6-B",
    "grade": 6,
    "officialText": "Nêu được khái niệm và lợi ích của mạng máy tính.",
    "officialTextHash": "ca6880fc8686596fb1ddb87019aa8261270eb147d91c3754f7a783e0b153001f",
    "cognitiveLevel": "nhan_biet",
    "competencyIds": [
