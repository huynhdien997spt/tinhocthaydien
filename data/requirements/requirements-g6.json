    "status": "published"
  },
  {
    "requirementId": "G6-B-03",
    "topicId": "G6-B",
    "grade": 6,
    "officialText": "Nêu được ví dụ cụ thể về trường hợp mạng không dây tiện dụng hơn mạng có dây.",
    "officialTextHash": "93680321e0346639ece30475f76aff9f9e9836ad9d645342827b83ddaed9e214",
    "cognitiveLevel": "thong_hieu",
    "competencyIds": [
