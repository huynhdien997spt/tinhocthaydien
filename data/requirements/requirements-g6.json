  },
  {
    "requirementId": "G6-C-01",
    "topicId": "G6-C",
    "grade": 6,
    "officialText": "Trình bày được sơ lược các khái niệm cơ bản về mạng thông tin toàn cầu: World Wide Web, website, địa chỉ của website, trình duyệt.",
    "officialTextHash": "55d5c267d50d5151a04fbe7fde7625fbae18cbb8303b72e13c052eb333133eed",
    "cognitiveLevel": "nhan_biet",
    "competencyIds": [
      "NLa",
      "NLd"
    ],
    "lessonIds": [
      "G6-L06"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-C-02",
    "topicId": "G6-C",
    "grade": 6,
    "officialText": "Xem và nêu được những thông tin chính trên trang web cho trước; khai thác được thông tin trên một số trang web thông dụng như tra từ điển, xem thời tiết, tin thời sự.",
    "officialTextHash": "fe71948a2700a97a537a3895a74a8466a0c982789b8b0eca447144ce3a177d98",
    "cognitiveLevel": "van_dung",
    "competencyIds": [
      "NLd"
    ],
    "lessonIds": [
      "G6-L06"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-C-03",
    "topicId": "G6-C",
    "grade": 6,
    "officialText": "Nêu được công dụng của máy tìm kiếm; xác định được từ khóa ứng với một mục đích tìm kiếm cho trước.",
    "officialTextHash": "4e59771b1b3050c47887c99beee238807bcd7722049e5a88d2837ea885e54722",
    "cognitiveLevel": "van_dung",
    "competencyIds": [
      "NLd"
    ],
    "lessonIds": [
      "G6-L07"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-C-04",
    "topicId": "G6-C",
    "grade": 6,
    "officialText": "Nêu được những ưu, nhược điểm cơ bản của dịch vụ thư điện tử so với các phương thức liên lạc khác.",
    "officialTextHash": "4ac8fbab014f8e8a9e12d0aa223e1366b6e13a51ee0ed1a4f5727f101f7ca1b9",
    "cognitiveLevel": "thong_hieu",
    "competencyIds": [
      "NLe"
    ],
    "lessonIds": [
      "G6-L08"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-C-05",
    "topicId": "G6-C",
    "grade": 6,
    "officialText": "Biết cách đăng kí tài khoản thư điện tử; thực hiện được một số thao tác cơ bản: đăng nhập, soạn, gửi và thoát khỏi tài khoản thư điện tử.",
    "officialTextHash": "a5e34aca57f11d291b9b84d2c173fa003d0e8680b8169b606dbc4d4b774ed677",
    "cognitiveLevel": "van_dung",
    "competencyIds": [
      "NLa",
      "NLe"
    ],
    "lessonIds": [
      "G6-L08"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-D-01",
    "topicId": "G6-D",
    "grade": 6,
    "officialText": "Nêu được một số tác hại và nguy cơ bị hại khi tham gia Internet; biết cách phòng vệ và bảo vệ thông tin cá nhân, gia đình khi giao tiếp qua mạng.",
    "officialTextHash": "d42939d674ee9572f3ba0be9d7cf770518328f476f1b6f6461136d565347be47",
    "cognitiveLevel": "thong_hieu",
    "competencyIds": [
      "NLb"
    ],
    "lessonIds": [
      "G6-L09"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-D-02",
    "topicId": "G6-D",
    "grade": 6,
    "officialText": "Trình bày được tầm quan trọng của sự an toàn và hợp pháp của thông tin cá nhân và tập thể, nêu được ví dụ minh họa.",
    "officialTextHash": "84a7f2ae8de105a77a84d699ede2673d029b1239d4028c69daab817cf749eb63",
    "cognitiveLevel": "thong_hieu",
    "competencyIds": [
      "NLb"
    ],
    "lessonIds": [
      "G6-L09"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-D-03",
    "topicId": "G6-D",
    "grade": 6,
    "officialText": "Nêu được một vài cách thông dụng để bảo vệ, chia sẻ thông tin của bản thân và tập thể sao cho an toàn và hợp pháp.",
    "officialTextHash": "d79d482fe0a858848ee12a03f8482e992a920b4ecceefefbb82e37da2817df31",
    "cognitiveLevel": "van_dung",
    "competencyIds": [
      "NLb",
      "NLe"
    ],
    "lessonIds": [
      "G6-L09"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-D-04",
    "topicId": "G6-D",
    "grade": 6,
    "officialText": "Nhận diện được một số thông điệp lừa đảo hoặc mang nội dung xấu và biết nhờ người lớn hỗ trợ để hạn chế tác hại từ Internet.",
    "officialTextHash": "542614b11053705ecdd14203a16b7d4dfa9eb7d700ee2d63ae57dcad815f7391",
    "cognitiveLevel": "van_dung",
    "competencyIds": [
      "NLb"
    ],
    "lessonIds": [
      "G6-L09"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-E-01",
    "topicId": "G6-E",
    "grade": 6,
    "officialText": "Giải thích được lợi ích của sơ đồ tư duy; sắp xếp được một cách logic và trình bày được dưới dạng sơ đồ tư duy các ý tưởng, khái niệm.",
    "officialTextHash": "2698000d41754d88d1e8acb55f007d73ead23e53406ca4cf940576edaa9e7c57",
    "cognitiveLevel": "thong_hieu",
    "competencyIds": [
      "NLc",
      "NLd"
    ],
    "lessonIds": [
      "G6-L10"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-E-02",
    "topicId": "G6-E",
    "grade": 6,
    "officialText": "Sử dụng được phần mềm để tạo sơ đồ tư duy đơn giản phục vụ học tập và trao đổi thông tin.",
    "officialTextHash": "3f8d950958b3dd034564afae057cdf63293cade91df3d13380ae85e08fba4c15",
    "cognitiveLevel": "van_dung",
    "competencyIds": [
      "NLa",
      "NLd",
      "NLe"
    ],
    "lessonIds": [
      "G6-L10"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-E-03",
    "topicId": "G6-E",
    "grade": 6,
    "officialText": "Nêu được các chức năng đặc trưng của những phần mềm soạn thảo văn bản; thực hiện được việc định dạng văn bản, trình bày trang văn bản và in.",
    "officialTextHash": "82b704c14924a99c5ff1e2af424873a0d5cbc74447f161bec9fa10a8dbf08a85",
    "cognitiveLevel": "van_dung",
    "competencyIds": [
      "NLa",
      "NLd"
    ],
    "lessonIds": [
      "G6-L11"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-E-04",
    "topicId": "G6-E",
    "grade": 6,
    "officialText": "Trình bày được thông tin ở dạng bảng bằng phần mềm soạn thảo văn bản.",
    "officialTextHash": "be5de9f2a5c9f62f80cc08f8e8a386766466ef6777e35d51e857bf6d1da553db",
    "cognitiveLevel": "van_dung",
    "competencyIds": [
      "NLa",
      "NLd"
    ],
    "lessonIds": [
      "G6-L12"
    ],
    "sourceId": "SRC-GDPT-2018-TIN6",
    "version": "2018.1",
    "reviewStatus": "approved_official",
    "status": "published"
  },
  {
    "requirementId": "G6-E-05",
    "topicId": "G6-E",
    "grade": 6,
    "officialText": "Sử dụng được công cụ tìm kiếm và thay thế của phần mềm soạn thảo văn bản.",
    "officialTextHash": "ab0a6a9d60cbb763e0b6f9b6dfa6f50b8976b335256da50eb7eb0e8f5632c26e",
    "cognitiveLevel": "van_dung",
    "competencyIds": [
      "NLa",
