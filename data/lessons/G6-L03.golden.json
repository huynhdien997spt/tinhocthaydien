  "questions": [
    {
      "questionId": "G6-L03-Q01",
      "grade": 6,
      "topicId": "G6-A",
      "lessonId": "G6-L03",
      "activityId": "G6-L03-A1",
      "requirementId": "G6-A-07",
      "questionType": "single_choice",
      "cognitiveLevel": "thong_hieu",
      "questionText": "[Fixture] Trong máy tính, thông tin được biểu diễn chỉ với hai kí hiệu nào?",
      "options": [
        {
          "id": "A",
          "text": "Hai chữ cái A và B"
        },
        {
          "id": "B",
          "text": "Hai kí hiệu 0 và 1"
        },
        {
          "id": "C",
          "text": "Các chữ số từ 0 đến 9"
        },
        {
          "id": "D",
          "text": "Các dấu chấm và gạch ngang"
        }
      ],
      "correctAnswer": "B",
      "explanation": "Máy tính biểu diễn và xử lí thông tin bằng các dãy bit chỉ gồm hai kí hiệu 0 và 1.",
      "maxScore": 1,
      "isFixtureOnly": true,
      "status": "published"
    },
    {
      "questionId": "G6-L03-Q02",
      "grade": 6,
      "topicId": "G6-A",
      "lessonId": "G6-L03",
      "activityId": "G6-L03-A2",
      "requirementId": "G6-A-08",
      "questionType": "single_choice",
      "cognitiveLevel": "nhan_biet",
      "questionText": "[Fixture] Đơn vị nhỏ nhất trong lưu trữ thông tin là gì?",
      "options": [
        {
          "id": "A",
          "text": "bit"
        },
        {
          "id": "B",
          "text": "Byte"
        },
        {
          "id": "C",
          "text": "KB"
        },
        {
          "id": "D",
          "text": "MB"
        }
      ],
      "correctAnswer": "A",
      "explanation": "Theo CTGDPT 2018 (G6-A-08), bit là đơn vị nhỏ nhất trong lưu trữ thông tin.",
      "maxScore": 1,
      "isFixtureOnly": true,
      "status": "published"
    },
    {
      "questionId": "G6-L03-Q03",
      "grade": 6,
      "topicId": "G6-A",
      "lessonId": "G6-L03",
      "activityId": "G6-L03-A3",
      "requirementId": "G6-A-09",
      "questionType": "single_choice",
      "cognitiveLevel": "van_dung",
      "questionText": "[Fixture] Theo quy đổi gần đúng hệ thập phân giữa các đơn vị cơ bản Byte, KB, MB, GB thì 1 GB xấp xỉ bằng bao nhiêu MB?",
      "options": [
        {
          "id": "A",
          "text": "Khoảng 100 MB"
        },
        {
          "id": "B",
          "text": "Khoảng 1000 MB"
        },
        {
          "id": "C",
          "text": "Khoảng 10 MB"
        },
        {
          "id": "D",
          "text": "Khoảng 8 MB"
        }
      ],
      "correctAnswer": "B",
      "explanation": "Theo hệ thập phân, các đơn vị cơ bản Byte, KB, MB, GB hơn kém nhau xấp xỉ 1000 lần nên 1 GB ≈ 1000 MB.",
      "maxScore": 1,
      "isFixtureOnly": true,
      "status": "published"
    },
    {
      "questionId": "G6-L03-Q04",
      "grade": 6,
      "topicId": "G6-A",
      "lessonId": "G6-L03",
      "activityId": "G6-L03-A4",
      "requirementId": "G6-A-10",
      "questionType": "single_choice",
      "cognitiveLevel": "thong_hieu",
      "questionText": "[Fixture] Trong các thiết bị nhớ thông dụng sau (đĩa cứng, USB, CD, thẻ nhớ), thiết bị nào thường có dung lượng lưu trữ lớn nhất trong máy tính cá nhân?",
      "options": [
        {
          "id": "A",
          "text": "Đĩa CD (khoảng 700 MB)"
        },
        {
          "id": "B",
          "text": "Đĩa cứng (hàng trăm GB trở lên)"
        },
        {
          "id": "C",
          "text": "Đĩa mềm (1.44 MB)"
        },
        {
          "id": "D",
          "text": "Thẻ nhớ 2 GB"
        }
      ],
      "correctAnswer": "B",
      "explanation": "Đĩa cứng là thiết bị nhớ thông dụng có khả năng lưu trữ lớn (hàng trăm GB trở lên), lớn hơn nhiều so với đĩa CD (~700 MB).",
      "maxScore": 1,
      "isFixtureOnly": true,
      "status": "published"
    }
