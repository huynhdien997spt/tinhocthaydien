{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement.schema.json",
  "title": "Requirement",
  "type": "object",
  "required": [
    "requirementId",
    "topicId",
    "grade",
    "officialText",
    "officialTextHash",
    "cognitiveLevel",
    "competencyIds",
    "sourceId",
    "version",
    "reviewStatus",
    "status"
  ],
  "properties": {
    "requirementId": {
      "type": "string",
      "pattern": "^G6-[A-F]-[0-9]{2}$"
    },
    "topicId": {
      "type": "string",
      "pattern": "^G6-[A-F]$"
    },
    "grade": {
      "type": "integer",
      "const": 6
    },
    "officialText": {
      "type": "string",
      "minLength": 10
    },
    "officialTextHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cognitiveLevel": {
      "type": "string",
      "enum": [
        "nhan_biet",
        "thong_hieu",
        "van_dung",
        "van_dung_cao"
      ]
    },
    "competencyIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^NL[a-e]$"
      }
    },
    "lessonIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^G6-L[0-9]{2}$"
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "approved_official",
        "under_review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    }
  },
  "additionalProperties": false
}
