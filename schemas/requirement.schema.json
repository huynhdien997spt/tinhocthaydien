{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/requirement.schema.json",
  "title": "Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirementId",
    "grade",
    "topicId",
    "officialText",
    "studentFriendlyText",
    "officialSourceId",
    "competencyIds",
    "evidenceTypes",
    "status",
    "version"
  ],
  "properties": {
    "requirementId": {
      "type": "string",
      "pattern": "^G6-[A-F]-[0-9]{2}$"
    },
    "grade": {
      "type": "integer",
      "const": 6
    },
    "topicId": {
      "type": "string",
      "pattern": "^G6-[A-F]$"
    },
    "subTopic": {
      "type": "string"
    },
    "officialText": {
      "type": "string"
    },
    "studentFriendlyText": {
      "type": "string"
    },
    "officialTextHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "officialSourceId": {
      "type": "string"
    },
    "cognitiveLevel": {
      "type": "string",
      "enum": [
        "nhan_biet",
        "thong_hieu",
        "van_dung",
        "van_dung_cao"
      ]
    },
    "competencyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lessonIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nlsMappings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aiCompetencyMappings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supplementaryKnowledge": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "approved_official",
        "pending_review",
        "rejected"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    },
    "version": {
      "type": "string"
    }
  }
}
