{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": [
    "evidenceId",
    "lessonId",
    "activityId",
    "requirementIds",
    "evidenceType",
    "title",
    "description",
    "status"
  ],
  "properties": {
    "evidenceId": {
      "type": "string",
      "pattern": "^EVD-G6-L[0-9]{2}-[0-9]{2}$"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^G6-L[0-9]{2}$"
    },
    "activityId": {
      "type": "string",
      "pattern": "^G6-L[0-9]{2}-A[0-9]+$"
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^G6-[A-F]-[0-9]{2}$"
      }
    },
    "nlsCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "quiz_response",
        "worksheet_table",
        "digital_artifact",
        "exit_ticket_reflection"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 5
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    }
  },
  "additionalProperties": false
}
