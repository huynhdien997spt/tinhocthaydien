{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceId",
    "studentUid",
    "schoolYear",
    "lessonId",
    "requirementId",
    "evidenceType",
    "sourceActivityId",
    "submittedAt",
    "evaluationStatus"
  ],
  "properties": {
    "evidenceId": {
      "type": "string"
    },
    "studentUid": {
      "type": "string"
    },
    "schoolYear": {
      "type": "string"
    },
    "lessonId": {
      "type": "string"
    },
    "requirementId": {
      "type": "string"
    },
    "evidenceType": {
      "type": "string"
    },
    "sourceActivityId": {
      "type": "string"
    },
    "submittedAt": {
      "type": "string"
    },
    "evaluationStatus": {
      "type": "string",
      "enum": [
        "pending",
        "evaluated",
        "needs_teacher_review",
        "approved"
      ]
    },
    "questionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "productId": {
      "type": [
        "string",
        "null"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "maxScore": {
      "type": [
        "number",
        "null"
      ]
    },
    "isCorrect": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "rubricResult": {
      "type": [
        "object",
        "null"
      ]
    },
    "teacherFeedback": {
      "type": [
        "string",
        "null"
      ]
    },
    "aiFeedback": {
      "type": [
        "string",
        "null"
      ]
    },
    "isFixtureSample": {
      "type": "boolean"
    }
  }
}
