{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/source.schema.json",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "title",
    "sourceType",
    "grade",
    "versionOrSchoolYear",
    "url",
    "authority",
    "priority",
    "licenseNote",
    "status",
    "createdAt",
    "updatedAt",
    "verifiedAt",
    "accessedAt",
    "verificationStatus",
    "scopeUsed"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "curriculum_regulation",
        "school_ppct",
        "textbook",
        "teacher_guide",
        "workbook",
        "digital_competency_framework",
        "school_deployment_appendix"
      ]
    },
    "grade": {
      "type": "integer",
      "const": 6
    },
    "versionOrSchoolYear": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "driveId": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "licenseNote": {
      "type": "string"
    },
    "verifiedAt": {
      "type": "string"
    },
    "accessedAt": {
      "type": "string"
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "verified",
        "pending_review",
        "rejected"
      ]
    },
    "scopeUsed": {
      "type": "string"
    },
    "layer": {
      "type": "string",
      "enum": [
        "Layer_A_Teacher_Provided",
        "Layer_B_Official_Authoritative"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "published",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
