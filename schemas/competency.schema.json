{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/competency.schema.json",
  "title": "Competency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "competencyId",
    "name",
    "levelScope",
    "officialDescription",
    "officialSourceId"
  ],
  "properties": {
    "competencyId": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "framework": {
      "type": "string",
      "enum": [
        "GDPT2018_TINHOC",
        "NLS_2025"
      ]
    },
    "domain": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "levelScope": {
      "type": "string"
    },
    "officialDescription": {
      "type": "string"
    },
    "officialSourceId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    }
  }
}
