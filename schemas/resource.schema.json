{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/resource.schema.json",
  "title": "Resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceId",
    "lessonId",
    "title",
    "resourceType",
    "requiresUrl",
    "url",
    "sourceId",
    "status"
  ],
  "properties": {
    "resourceId": {
      "type": "string"
    },
    "lessonId": {
      "type": "string"
    },
    "topicId": {
      "type": "string"
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "interactive_lesson",
        "simulation",
        "video",
        "reference_doc",
        "worksheet"
      ]
    },
    "requiresUrl": {
      "type": "boolean"
    },
    "url": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    }
  }
}
