{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource.schema.json",
  "title": "Resource",
  "type": "object",
  "required": [
    "resourceId",
    "lessonId",
    "title",
    "resourceType",
    "requiresUrl",
    "url",
    "sourceId",
    "status"
  ],
  "properties": {
    "resourceId": {
      "type": "string",
      "pattern": "^RES-G6-[A-Z0-9-]+$"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^G6-L[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "interactive_lesson",
        "simulation",
        "video",
        "worksheet",
        "reference_doc",
        "offline_handout"
      ]
    },
    "requiresUrl": {
      "type": "boolean"
    },
    "url": {
      "type": "string"
    },
    "sourceId": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    }
  },
  "additionalProperties": false
}
