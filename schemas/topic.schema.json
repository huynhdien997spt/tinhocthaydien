{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/topic.schema.json",
  "title": "Topic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topicId",
    "grade",
    "code",
    "title",
    "order",
    "officialSourceId",
    "status"
  ],
  "properties": {
    "topicId": {
      "type": "string",
      "pattern": "^G6-[A-F]$"
    },
    "grade": {
      "type": "integer",
      "const": 6
    },
    "code": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "title": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "officialSourceId": {
      "type": "string"
    },
    "expectedRequirementCount": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    }
  }
}
