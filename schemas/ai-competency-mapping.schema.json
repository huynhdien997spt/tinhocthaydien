{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-competency-mapping.schema.json",
  "title": "AICompetencyMapping",
  "type": "object",
  "required": [
    "aiMappingId",
    "lessonId",
    "requirementIds",
    "aiCompetencyCode",
    "rationale",
    "teacherApproved",
    "status"
  ],
  "properties": {
    "aiMappingId": {
      "type": "string",
      "pattern": "^AI-MAP-[A-Z0-9-]+$"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^G6-L[0-9]{2}$"
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^G6-[A-F]-[0-9]{2}$"
      }
    },
    "aiCompetencyCode": {
      "type": "string",
      "minLength": 2
    },
    "rationale": {
      "type": "string",
      "minLength": 5
    },
    "teacherApproved": {
      "type": "boolean"
    },
    "approvedBy": {
      "type": "string"
    },
    "approvedAt": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    }
  },
  "additionalProperties": false
}
