{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/ai-competency-mapping.schema.json",
  "title": "AICompetencyMapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aiMappingId",
    "lessonId",
    "requirementIds",
    "aiCompetencyCode",
    "rationale",
    "teacherApproved",
    "status"
  ],
  "properties": {
    "aiMappingId": {
      "type": "string"
    },
    "lessonId": {
      "type": "string"
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aiCompetencyCode": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "teacherApproved": {
      "type": "boolean"
    },
    "approvedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "approvedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    }
  }
}
