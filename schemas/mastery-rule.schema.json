{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/mastery-rule.schema.json",
  "title": "MasteryRule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "masteryRuleId",
    "requirementId",
    "minimumEvidenceCount",
    "requiredEvidenceTypes",
    "thresholds",
    "recencyRule",
    "teacherOverrideAllowed"
  ],
  "properties": {
    "masteryRuleId": {
      "type": "string"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^G6-[A-F]-[0-9]{2}$"
    },
    "lessonId": {
      "type": "string"
    },
    "minimumEvidenceCount": {
      "type": "integer"
    },
    "requiredEvidenceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thresholds": {
      "type": "object",
      "required": [
        "insufficient_evidence",
        "developing",
        "achieved",
        "extended"
      ],
      "properties": {
        "insufficient_evidence": {
          "type": "object"
        },
        "developing": {
          "type": "object"
        },
        "achieved": {
          "type": "object"
        },
        "extended": {
          "type": "object"
        }
      }
    },
    "recencyRule": {
      "type": "string"
    },
    "teacherOverrideAllowed": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    }
  }
}
