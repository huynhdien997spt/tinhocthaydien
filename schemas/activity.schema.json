{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "activity.schema.json",
  "title": "Activity",
  "type": "object",
  "required": [
    "activityId",
    "lessonId",
    "code",
    "type",
    "title",
    "durationMinutes",
    "requirementIds",
    "educationalPurposeApproved",
    "status"
  ],
  "properties": {
    "activityId": {
      "type": "string",
      "pattern": "^G6-L[0-9]{2}-A[0-9]+$"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^G6-L[0-9]{2}$"
    },
    "code": {
      "type": "string",
      "pattern": "^A[0-9]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "opening",
        "knowledge",
        "practice",
        "application",
        "reflection",
        "exit-ticket"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "objective": {
      "type": "string"
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^G6-[A-F]-[0-9]{2}$"
      }
    },
    "educationalPurposeApproved": {
      "type": "boolean"
    },
    "educationalPurposeNote": {
      "type": "string"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    }
  },
  "additionalProperties": false
}
