{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/activity.schema.json",
  "title": "Activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activityId",
    "lessonId",
    "order",
    "activityType",
    "objective",
    "instruction",
    "requirementIds",
    "expectedEvidenceTypes",
    "required",
    "supportPolicyId"
  ],
  "properties": {
    "activityId": {
      "type": "string"
    },
    "lessonId": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "activityType": {
      "type": "string",
      "enum": [
        "opening",
        "knowledge",
        "practice",
        "application",
        "warm_up",
        "reflection"
      ]
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "instruction": {
      "type": "string"
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedEvidenceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required": {
      "type": "boolean"
    },
    "supportPolicyId": {
      "type": "string"
    },
    "resourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimatedMinutes": {
      "type": "integer"
    },
    "allowExternalNavigation": {
      "type": "boolean"
    },
    "scoringMethod": {
      "type": "string"
    },
    "educationalPurposeApproved": {
      "type": "boolean"
    },
    "educationalPurposeNote": {
      "type": "string"
    },
    "isFixtureOnly": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    }
  }
}
