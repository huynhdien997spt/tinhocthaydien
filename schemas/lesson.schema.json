{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "required": [
    "lessonId",
    "ppctNumber",
    "grade",
    "topicId",
    "title",
    "periods",
    "durationMinutes",
    "requirementIds",
    "competencyIds",
    "nlsCodes",
    "sourceId",
    "status"
  ],
  "properties": {
    "lessonId": {
      "type": "string",
      "pattern": "^G6-L[0-9]{2}$"
    },
    "legacyLessonId": {
      "type": "string"
    },
    "ppctNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 17
    },
    "grade": {
      "type": "integer",
      "const": 6
    },
    "topicId": {
      "type": "string",
      "pattern": "^G6-[A-F]$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "periods": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 45,
      "maximum": 180
    },
    "learningModel": {
      "type": "string",
      "enum": [
        "WebQuest",
        "PRIMM",
        "PRIDAM",
        "ActivityBased"
      ]
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^G6-[A-F]-[0-9]{2}$"
      }
    },
    "competencyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^NL[a-e]$"
      }
    },
    "nlsCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activityIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "masteryRuleId": {
      "type": "string"
    },
    "sourceId": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    }
  },
  "additionalProperties": false
}
