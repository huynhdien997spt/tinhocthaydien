{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lessonId",
    "grade",
    "topicId",
    "title",
    "order",
    "durationMinutes",
    "requirementIds",
    "competencyIds",
    "activityIds",
    "assessmentPlan",
    "resourceIds",
    "status",
    "version",
    "sourceRefs"
  ],
  "properties": {
    "lessonId": {
      "type": "string",
      "pattern": "^G6-L[0-9]{2}$"
    },
    "legacyLessonId": {
      "type": [
        "string",
        "null"
      ]
    },
    "lessonNumber": {
      "type": "integer"
    },
    "grade": {
      "type": "integer",
      "const": 6
    },
    "topicId": {
      "type": "string",
      "pattern": "^G6-[A-F]$"
    },
    "title": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "periods": {
      "type": "integer"
    },
    "durationMinutes": {
      "type": "integer"
    },
    "sessionType": {
      "type": "string",
      "const": "lesson"
    },
    "learningModel": {
      "type": "string"
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competencyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nlsCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activityIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessmentPlan": {
      "type": "object"
    },
    "resourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "masteryRuleIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supplementaryKnowledge": {
      "type": [
        "string",
        "null"
      ]
    },
    "isFixtureOnly": {
      "type": "boolean"
    },
    "fixtureNote": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    },
    "version": {
      "type": "string"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scheduledPeriods": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}
