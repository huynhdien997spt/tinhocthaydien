{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/question.schema.json",
  "title": "Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questionId",
    "grade",
    "topicId",
    "lessonId",
    "requirementId",
    "questionType",
    "cognitiveLevel",
    "questionText",
    "correctAnswer",
    "explanation",
    "maxScore",
    "status"
  ],
  "properties": {
    "questionId": {
      "type": "string"
    },
    "grade": {
      "type": "integer",
      "const": 6
    },
    "topicId": {
      "type": "string",
      "pattern": "^G6-[A-F]$"
    },
    "lessonId": {
      "type": "string"
    },
    "activityId": {
      "type": "string"
    },
    "requirementId": {
      "type": "string"
    },
    "questionType": {
      "type": "string",
      "enum": [
        "single_choice",
        "multiple_choice",
        "short_answer",
        "true_false",
        "matching"
      ]
    },
    "cognitiveLevel": {
      "type": "string",
      "enum": [
        "nhan_biet",
        "thong_hieu",
        "van_dung",
        "van_dung_cao"
      ]
    },
    "questionText": {
      "type": "string"
    },
    "options": {
      "type": "array"
    },
    "correctAnswer": {
      "type": [
        "string",
        "array"
      ]
    },
    "explanation": {
      "type": "string"
    },
    "maxScore": {
      "type": "number"
    },
    "isFixtureOnly": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    }
  }
}
