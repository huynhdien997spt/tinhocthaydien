{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinhocthaydien.edu.vn/schemas/nls-mapping.schema.json",
  "title": "NLSMapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mappingId",
    "lessonId",
    "requirementIds",
    "nlsCode",
    "competencyId",
    "frameworkSourceId",
    "mappingSourceId",
    "mappingOriginType",
    "isOfficialGdpt2018Requirement",
    "rationale",
    "status"
  ],
  "properties": {
    "mappingId": {
      "type": "string",
      "pattern": "^NLS-MAP-[A-Z0-9-]+$"
    },
    "lessonId": {
      "type": "string"
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nlsCode": {
      "type": "string"
    },
    "competencyId": {
      "type": "string"
    },
    "frameworkSourceId": {
      "type": "string"
    },
    "mappingSourceId": {
      "type": "string"
    },
    "mappingOriginType": {
      "type": "string",
      "enum": [
        "school_deployment_appendix_khbd",
        "school_education_plan",
        "teacher_lesson_plan"
      ]
    },
    "isOfficialGdpt2018Requirement": {
      "type": "boolean",
      "const": false
    },
    "rationale": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ]
    },
    "supplementaryLessonPlanSourceId": {
      "type": "string"
    },
    "mappingDriveId": {
      "type": "string"
    },
    "supplementaryLessonPlanDriveId": {
      "type": "string"
    }
  }
}
