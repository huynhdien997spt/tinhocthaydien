      "sourceId": "SRC-GDPT-2018-TIN6",
      "version": "2018.1",
      "reviewStatus": "approved_official",
      "status": "published"
    },
    {
      "requirementId": "G6-B-04",
      "topicId": "G6-B",
      "grade": 6,
      "officialText": "Giới thiệu tóm tắt được các đặc điểm và lợi ích chính của Internet.",
      "officialTextHash": "a7fce11ef66af002a450f0a057fdad88793b7c99929172ad5db783f3cf306dfd",
      "cognitiveLevel": "thong_hieu",
      "competencyIds": [
