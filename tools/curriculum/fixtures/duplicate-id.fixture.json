    {
      "requirementId": "G6-A-07",
      "topicId": "G6-A",
      "grade": 6,
      "officialText": "Giải thích được có thể biểu diễn thông tin chỉ với hai kí hiệu 0 và 1.",
      "officialTextHash": "5562d141c6cce1b1f0e05c416ef985669ec334e11f411f8cf2416ceb6749fa2e",
