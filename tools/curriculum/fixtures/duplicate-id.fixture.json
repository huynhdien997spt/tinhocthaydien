    },
    {
      "requirementId": "G6-A-08",
      "topicId": "G6-A",
      "grade": 6,
      "officialText": "Biết được bit là đơn vị nhỏ nhất trong lưu trữ thông tin.",
      "officialTextHash": "4c8da387f2adcd984a046e20477db75c7f03f319037e7496b81281d3034dd0a2",
      "cognitiveLevel": "nhan_biet",
